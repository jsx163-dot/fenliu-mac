QWidget {
    color: #232a36;
    font-size: 13px;
}
QMainWindow, QDialog, QWidget#bookingWorkspace, QWidget#journeyForm {
    background: #ffffff;
}
QLabel { background: transparent; }
QLabel[muted="true"] { color: #737d8d; }
QLabel[status="error"] { color: #b43f46; }
QLabel#applicationBrand { font-size: 18px; font-weight: 600; }
QLabel#loginBrand { font-size: 22px; font-weight: 600; padding: 12px 0; }
QWidget#applicationHeader {
    background: #ffffff;
    border-bottom: 1px solid #e5e8ee;
}
QLabel#localEdition {
    color: #667283;
    font-size: 11px;
    padding-left: 8px;
}
QPushButton, QToolButton {
    background: #ffffff;
    border: 1px solid #dce1e8;
    border-radius: 5px;
    padding: 6px 12px;
    min-height: 20px;
}
QPushButton:hover, QToolButton:hover {
    background: #f4f6fa;
    border-color: #bcc5d3;
}
QPushButton:pressed, QToolButton:pressed { background: #e9edf4; }
QPushButton:focus, QToolButton:focus { border-color: #315ed4; }
QPushButton[role="primary"] {
    background: #315ed4;
    color: #ffffff;
    border-color: #315ed4;
    font-weight: 600;
}
QPushButton[role="primary"]:hover { background: #284fbd; border-color: #284fbd; }
QPushButton[role="primary"]:pressed { background: #2244a4; }
QPushButton[role="accent"] {
    background: #edf6f3;
    color: #28785f;
    border-color: #cce3d9;
}
QPushButton:disabled, QToolButton:disabled {
    color: #9299a5;
    background: #f4f5f7;
    border-color: #e6e9ee;
}
QPushButton[role="icon"] { padding: 0; min-width: 32px; min-height: 32px; }
QLineEdit, QComboBox, QAbstractSpinBox {
    background: #ffffff;
    border: 1px solid #d9dfe8;
    border-radius: 5px;
    padding: 6px 10px;
    min-height: 20px;
    selection-background-color: #dce7ff;
    selection-color: #232a36;
}
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover { border-color: #a9b6c9; }
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus { border-color: #315ed4; }
QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled {
    color: #9299a5;
    background: #f5f6f8;
    border-color: #e4e8ee;
}
QComboBox { padding-right: 28px; }
QComboBox::drop-down {
    border: none;
    width: 26px;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}
QComboBox::down-arrow { image: url(:/ui/icons/chevron-down.svg); width: 14px; height: 14px; }
QAbstractSpinBox { padding-right: 28px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    border: none;
    width: 22px;
    subcontrol-origin: border;
}
QAbstractSpinBox::up-button { subcontrol-position: top right; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; }
QAbstractSpinBox::up-arrow { image: url(:/ui/icons/chevron-up.svg); width: 12px; height: 12px; }
QAbstractSpinBox::down-arrow { image: url(:/ui/icons/chevron-down.svg); width: 12px; height: 12px; }
QDateEdit::drop-down {
    border: none;
    width: 26px;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}
QDateEdit::down-arrow { image: url(:/ui/icons/chevron-down.svg); width: 14px; height: 14px; }
QCheckBox, QRadioButton { spacing: 7px; min-height: 22px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px; height: 15px;
    background: #ffffff; border: 1px solid #c4ccd8;
}
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked { background: #315ed4; border-color: #315ed4; image: url(:/ui/icons/check-white.svg); }
QCheckBox::indicator:indeterminate { background: #a9bde9; }
QRadioButton::indicator:checked { background: #ffffff; border-color: transparent; image: url(:/ui/icons/circle-dot.svg); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background: #e9edf3; border-color: #d4dae3; }
QCheckBox:disabled, QRadioButton:disabled { color: #9299a5; }
QTableView, QListView, QTextEdit, QTextBrowser {
    background: #ffffff;
    alternate-background-color: #f8f9fb;
    border: 1px solid #e2e6ed;
    border-radius: 4px;
    selection-background-color: #eaf0ff;
    selection-color: #244fbc;
    outline: none;
}
QTableView { gridline-color: #edf0f4; }
QTableView::item { padding: 6px 8px; border-bottom: 1px solid #edf0f4; }
QTableView::item:selected { background: #eaf0ff; }
QHeaderView { background: #f6f7fa; }
QHeaderView::section {
    background: #f6f7fa;
    color: #626e80;
    font-size: 12px;
    font-weight: 500;
    border: none;
    border-bottom: 1px solid #e2e6ed;
    padding: 8px 7px;
    min-height: 18px;
}
QTableCornerButton::section { background: #f6f7fa; border: none; }
QListView { padding: 4px; }
QListView::item { padding: 5px 7px; min-height: 19px; border-radius: 3px; }
QListView::item:hover { background: #f3f6fb; }
QListView::item:selected { background: #eaf0ff; color: #244fbc; }
QListView::indicator {
    width: 15px; height: 15px; border-radius: 3px;
    border: 1px solid #c4ccd8; background: #ffffff;
}
QListView::indicator:checked { background: #315ed4; border-color: #315ed4; image: url(:/ui/icons/check-white.svg); }
QTextEdit, QTextBrowser { padding: 8px; }
QTextBrowser#activityLog { font-size: 12px; }
QTabWidget::pane { border: none; border-top: 1px solid #e5e8ee; background: #ffffff; }
QTabWidget::tab-bar { left: 16px; }
QTabBar::tab {
    color: #737d8d;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 16px;
    min-height: 18px;
}
QTabBar::tab:selected { color: #315ed4; border-bottom-color: #315ed4; font-weight: 600; }
QTabBar::tab:hover:!selected { background: #f5f7fb; color: #35425a; }
QTabBar::tab:disabled { color: #a0a7b3; }
QTabWidget#activityViews::tab-bar { left: 0; }
QTabWidget#activityViews QTabBar::tab { padding: 4px 10px; font-size: 12px; min-height: 16px; }
QMainWindow::separator { background: #e8ecf2; width: 1px; height: 1px; }
QMainWindow::separator:hover { background: #c6d2e7; }
QDockWidget::title { background: #f6f7fa; padding: 4px 10px; color: #737d8d; }
QWidget#bookingControls, QFrame#supportBar { background: #f8f9fb; border-top: 1px solid #e5e8ee; }
QFrame#advertisingSlot { background: #ffffff; border: 1px dashed #dce1e8; border-radius: 4px; }
QLabel#sponsorPlaceholder { border: 1px dashed #c8d0dc; border-radius: 4px; color: #818b9b; font-size: 11px; }
QLabel#sponsorStatus, QLabel#advertisingStatus, QLabel#advertisingBadge { color: #7d8796; font-size: 12px; }
QLabel#sponsorTitle, QLabel#advertisingTitle { font-size: 13px; font-weight: 600; }
QLabel#journeyOrderStatus { color: #8f681d; background: #fff9ed; border-radius: 4px; padding: 7px 10px; }
QStatusBar { background: #ffffff; border-top: 1px solid #e5e8ee; color: #737d8d; font-size: 12px; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #737d8d; font-size: 12px; }
QProgressBar {
    background: #e9edf4;
    border: none;
    border-radius: 3px;
    color: #737d8d;
    text-align: center;
    max-height: 6px;
}
QProgressBar::chunk { background: #5077d4; border-radius: 3px; }
QGroupBox {
    border: 1px solid #e2e6ed;
    border-radius: 4px;
    margin-top: 18px;
    padding: 12px 10px 10px;
}
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 10px; padding: 0 4px; color: #515b6d; }
QScrollArea { border: none; background: #ffffff; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 0; }
QScrollBar::handle:vertical { background: #cbd2dd; border-radius: 4px; min-height: 28px; margin: 1px; }
QScrollBar::handle:horizontal { background: #cbd2dd; border-radius: 4px; min-width: 28px; margin: 1px; }
QScrollBar::handle:hover { background: #a6b2c3; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: transparent; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QMenuBar { background: #ffffff; }
QMenuBar::item { padding: 5px 10px; background: transparent; }
QMenuBar::item:selected { background: #eaf0ff; }
QMenu { background: #ffffff; border: 1px solid #dce1e8; padding: 4px; }
QMenu::item { padding: 7px 28px 7px 12px; border-radius: 3px; }
QMenu::item:selected { background: #eaf0ff; color: #244fbc; }
QMenu::separator { height: 1px; background: #e5e8ee; margin: 4px 8px; }
QToolTip { background: #232a36; color: #ffffff; border: none; padding: 6px 9px; }
QCalendarWidget QWidget#qt_calendar_navigationbar { background: #f6f7fa; }
QCalendarWidget QToolButton { color: #232a36; border: none; padding: 3px 8px; }
QCalendarWidget QAbstractItemView { selection-background-color: #eaf0ff; selection-color: #244fbc; }
